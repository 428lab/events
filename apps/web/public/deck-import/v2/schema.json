{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/deck-import/v2/schema.json",
  "$comment": "Schema alone cannot guarantee acceptance. spec.md and the shared validator additionally enforce UTF-16 lengths, valid Unicode, URL protocol and credentials, duplicate keys, depth, UTF-8 bytes and aggregate counts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "slides"
  ],
  "properties": {
    "format": {
      "const": "events-lab-deck"
    },
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 0,
      "maxLength": 120
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "background",
          "elements"
        ],
        "properties": {
          "background": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "elements": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 10000
                    },
                    "fontSize": {
                      "type": "number",
                      "minimum": 0
                    },
                    "font": {
                      "enum": [
                        "default",
                        "Plus Jakarta Sans",
                        "serif",
                        "monospace",
                        "Noto Sans JP",
                        "M PLUS 1p",
                        "BIZ UDPGothic",
                        "Sawarabi Gothic",
                        "Zen Kaku Gothic New",
                        "IBM Plex Sans JP",
                        "M PLUS Rounded 1c",
                        "Zen Maru Gothic",
                        "Kosugi Maru",
                        "Mochiy Pop One",
                        "RocknRoll One",
                        "Noto Serif JP",
                        "Shippori Mincho",
                        "Zen Old Mincho",
                        "Sawarabi Mincho",
                        "Kaisei Decol",
                        "Shippori Antique",
                        "Dela Gothic One",
                        "Reggae One",
                        "Train One",
                        "Yuji Syuku",
                        "Yusei Magic",
                        "Hachi Maru Pop",
                        "Klee One",
                        "Stick",
                        "DotGothic16"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "align": {
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    },
                    "rotation": {
                      "type": "number"
                    },
                    "group": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "type": {
                      "const": "image-placeholder"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "rotation": {
                      "type": "number"
                    },
                    "group": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h",
                    "src"
                  ],
                  "properties": {
                    "type": {
                      "const": "image-url"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "src": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "rotation": {
                      "type": "number"
                    },
                    "group": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
