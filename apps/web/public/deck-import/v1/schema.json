{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/deck-import/v1/schema.json",
  "$comment": "Schema alone cannot guarantee acceptance. spec.md and the shared validator additionally enforce UTF-16 lengths, valid Unicode, duplicate keys, depth, UTF-8 bytes, coordinate sums and aggregate counts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "slides"
  ],
  "properties": {
    "format": {
      "const": "events-lab-deck"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "background",
          "elements"
        ],
        "properties": {
          "background": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "elements": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h",
                    "text",
                    "fontSize",
                    "font",
                    "color",
                    "bold",
                    "italic",
                    "align"
                  ],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 940
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 520
                    },
                    "w": {
                      "type": "integer",
                      "minimum": 20,
                      "maximum": 960
                    },
                    "h": {
                      "type": "integer",
                      "minimum": 20,
                      "maximum": 540
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    },
                    "fontSize": {
                      "type": "integer",
                      "minimum": 12,
                      "maximum": 160
                    },
                    "font": {
                      "enum": [
                        "default",
                        "serif",
                        "monospace"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "align": {
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "type": {
                      "const": "image-placeholder"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 940
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 520
                    },
                    "w": {
                      "type": "integer",
                      "minimum": 20,
                      "maximum": 960
                    },
                    "h": {
                      "type": "integer",
                      "minimum": 20,
                      "maximum": 540
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
