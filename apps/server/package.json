{
  "name": "@eventer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && wrangler dev",
    "deploy": "cd ../.. && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:local": "cd ../.. && wrangler d1 migrations apply eventer --local",
    "db:migrate:remote": "cd ../.. && wrangler d1 migrations apply eventer --remote"
  },
  "dependencies": {
    "@eventer/shared": "workspace:*",
    "hono": "^4.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250510.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "better-sqlite3": "^11.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.85.0"
  }
}
