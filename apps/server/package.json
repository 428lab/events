{
  "name": "@eventer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && wrangler dev",
    "deploy": "cd ../.. && wrangler deploy",
    "deploy:staging": "cd ../.. && wrangler deploy --env staging",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "cd ../.. && wrangler d1 migrations apply eventer --local",
    "db:migrate:remote": "cd ../.. && wrangler d1 migrations apply eventer --remote"
  },
  "dependencies": {
    "@eventer/shared": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "hono": "^4.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250510.0",
    "@types/node": "^22.9.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.85.0"
  }
}
