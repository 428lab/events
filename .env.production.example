# 本番用 env (.env.production)。NODE_ENV=production のとき読まれる。
# dev-login は本番ビルドから静的に除去されるため、ログインは Discord OAuth のみ。
NODE_ENV=production
PORT=8080

# Discord OAuth2（必須）
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://<YOUR_HOST>/api/auth/discord/callback

SESSION_SECRET=set-a-long-random-string
APP_BASE_URL=https://<YOUR_HOST>

# アプリ運営管理者の Discord ユーザーID（カンマ区切りで複数可）
# 例: ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=
DATABASE_PATH=./data/eventer.db
WEB_DIST_PATH=apps/web/dist
