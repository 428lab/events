# 開発用 env (.env)。NODE_ENV!=production のとき読まれる。
# 開発では Discord ログインと dev-login の両方が使える。
NODE_ENV=development
PORT=4281
# 開発アプリは vite(4280) 経由。Discord ループバック要件のため localhost ではなく 127.0.0.1
APP_BASE_URL=http://127.0.0.1:4280
DATABASE_PATH=./data/eventer.dev.db

# Discord OAuth（開発で Discord ログインを使う場合）
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:4280/api/auth/discord/callback
SESSION_SECRET=dev-secret

# アプリ運営管理者の Discord ユーザーID（カンマ区切り）。dev-login 検証用に dev-user を入れてもよい
ADMIN_DISCORD_IDS=

# 本番用は .env.production.example を参照（PORT=8080 / Discord 認証情報必須）。
